# ==============================================================================
# WEGOTCHU Environment Configuration Template
# Copy this file to .env and configure local development values.
# NEVER commit the real .env file or production secrets to Git!
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-a-secure-random-32-character-secret-key

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=postgresql://wegotchu_user:wegotchu_password@localhost:5432/wegotchu_db

# External LLM / GenAI Integration
# NOTE: The LLM is used EXCLUSIVELY for communication synthesis and user check-in
# generation. The LLM NEVER determines risk level or executes safety policy actions.
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.2

# Notification & Emergency Services (Staging / Mock)
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Geocoding & Mapping Baseline (Optional)
MAPS_API_KEY=

# Edge / Local Model Paths
ONNX_MODEL_DIR=./ai/exported_models
